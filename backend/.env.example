DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sugarcane_inventory?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
# Set to "true" only when this app actually sits behind a real reverse proxy
# (nginx, a load balancer, etc.) — otherwise leave unset. Enabling it without a
# real proxy in front lets a client spoof X-Forwarded-For to bypass rate limiting.
TRUST_PROXY=false
